# Jawna konfiguracja mon-home-ass -> ConfigMap mon-home-ass-config (configMapGenerator).
# Sekrety: secrets.sops.env (SOPS). Opis zmiennych: .devops/README.md.
DB_TYPE=postgres
DB_DRIVER=org.postgresql.Driver
DB_URL=postgres.apps.svc.cluster.local:5432
DB_NAME=home_assistant
DB_USER=mon_home_ass
NATS_URL=nats://nats.apps.svc.cluster.local:4222
NATS_STREAM=HOME_ASSISTANT
NATS_SUBJECT=home-assistant.statistics
NATS_INTERVAL_SECONDS=60
